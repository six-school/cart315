{
  "name": "usagi-test",
  "private": "true",
  "version": "1.0.0",
  "scripts": {
    "build": "tstl",
    "dev": "run-p -l dev:*",
    "dev:tstl": "tstl --watch",
    "dev:usagi": "./bin/usagi dev game",
    "test": "run-p -cl test:*",
    "test:ts": "tsc --pretty --noEmit",
    "test:eslint": "eslint --color --max-warnings=0 '{src,scripts}/**/*'",
    "test:prettier": "prettier '{src,scripts}/**/*' -l",
    "prettier": "prettier '{src,scripts}/**/*' --write"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-lostfictions": "8.1.1",
    "lua-types": "^2.14.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-to-lua": "^1.37.1"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
